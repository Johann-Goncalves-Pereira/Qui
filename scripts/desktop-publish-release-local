#!/usr/bin/env bash
# Publish (or refresh) a GitHub Release for the current desktop version ($0 Actions).
# Expects tag v<ver> already on origin. Uploads dmg/zip from desktop/release/ when present.

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "desktop-publish-release-local: not inside a git repository" >&2
  exit 1
}
cd "$ROOT"

VER="$(node -p "require('./desktop/package.json').version")"
TAG="v${VER}"
TITLE="Qui v${VER}"

if ! git ls-remote --tags origin "refs/tags/${TAG}" | grep -q .; then
  echo "desktop-publish-release-local: origin missing tag ${TAG}; run desktop-version-bump-local first" >&2
  exit 1
fi

ARCH="${QUI_IMAGE_ARCH:-arm64}"
IMAGE_ARCHIVE="desktop/release/qui-desktop-image-${ARCH}.tar.gz"

if [ ! -f "$IMAGE_ARCHIVE" ] && [ -x "$ROOT/scripts/desktop-publish-qui-image" ] && [ "${QUI_SKIP_IMAGE_BUILD:-}" != "1" ]; then
  echo "desktop-publish-release-local: container image archive missing for ${VER}; building with desktop-publish-qui-image..."
  "$ROOT/scripts/desktop-publish-qui-image" || {
    echo "desktop-publish-release-local: warning: desktop-publish-qui-image failed" >&2
  }
fi

if [ ! -f "desktop/release/Qui-${VER}-arm64.dmg" ]; then
  echo "desktop-publish-release-local: release DMG missing for ${VER}; packaging with pnpm --dir desktop package:mac:release..."
  pnpm --dir desktop package:mac:release
fi

ASSETS=()
shopt -s nullglob
for f in desktop/release/Qui-"${VER}"-*.dmg desktop/release/Qui-"${VER}"-*-mac.zip desktop/release/qui-desktop-image-*.tar.gz; do
  ASSETS+=("$f")
done
shopt -u nullglob

# Find previous tag to extract changes
PREV_TAG="$(git describe --tags --abbrev=0 "${TAG}^" 2>/dev/null || echo "")"
CHANGELOG=""
if [ -n "$PREV_TAG" ]; then
  COMMITS="$(git log "${PREV_TAG}..${TAG}" --pretty=format:"* %s (%h)" --no-merges 2>/dev/null || true)"
  if [ -z "$COMMITS" ]; then
    COMMITS="$(git log "${PREV_TAG}..${TAG}" --oneline 2>/dev/null || true)"
  fi
  if [ -n "$COMMITS" ]; then
    CHANGELOG="$(cat <<EOF

## What's Changed
${COMMITS}

**Full Changelog**: https://github.com/Johann-Goncalves-Pereira/Qui/compare/${PREV_TAG}...${TAG}
EOF
)"
  fi
fi

NOTES="$(cat <<EOF
Qui Desktop **${TAG}** (matches \`desktop/package.json\`).
${CHANGELOG}

Unsigned macOS build. If Gatekeeper blocks launch:
\`\`\`bash
xattr -cr /Applications/Qui.app
\`\`\`

The Qui **GUI** ships as this fork’s Docker image (not \`ghcr.io/autobrr/qui\`).
Packaged apps embed the \`qui-desktop-image-*.tar.gz\` archive directly inside
\`Qui.app/Contents/Resources/assets/\` for offline, zero-network first launch.
When updating or launching, Qui Desktop automatically synchronizes and recreates
the container using the matching versioned tag.

Built/published locally while GitHub Actions usage is blocked (\$0 budget).
EOF
)"

if gh release view "$TAG" >/dev/null 2>&1; then
  echo "desktop-publish-release-local: release ${TAG} exists; verifying assets and ensuring Latest"
  gh release edit "$TAG" --title "$TITLE" --notes "$NOTES" --latest
  if [ "${#ASSETS[@]}" -gt 0 ]; then
    EXISTING_ASSETS="$(gh release view "$TAG" --json assets --jq '.assets[] | "\(.name):\(.size)"' 2>/dev/null || true)"
    UPLOAD_CANDIDATES=()
    for f in "${ASSETS[@]}"; do
      fname="$(basename "$f")"
      fsize="$(stat -f%z "$f" 2>/dev/null || stat -c%s "$f" 2>/dev/null || echo 0)"
      if printf '%s\n' "$EXISTING_ASSETS" | grep -qx "${fname}:${fsize}"; then
        echo "desktop-publish-release-local: asset ${fname} (${fsize} bytes) already matches ${TAG}; skipping"
      else
        UPLOAD_CANDIDATES+=("$f")
      fi
    done

    if [ "${#UPLOAD_CANDIDATES[@]}" -gt 0 ]; then
      echo "desktop-publish-release-local: uploading ${#UPLOAD_CANDIDATES[@]} new/updated asset(s) to ${TAG}"
      gh release upload "$TAG" "${UPLOAD_CANDIDATES[@]}" --clobber
    else
      echo "desktop-publish-release-local: all ${#ASSETS[@]} assets already up to date on ${TAG}"
    fi
  fi
else
  echo "desktop-publish-release-local: creating ${TAG} as Latest"
  if [ "${#ASSETS[@]}" -gt 0 ]; then
    gh release create "$TAG" --title "$TITLE" --notes "$NOTES" --latest "${ASSETS[@]}"
  else
    gh release create "$TAG" --title "$TITLE" --notes "$NOTES" --latest
    echo "desktop-publish-release-local: no desktop/release assets for ${VER}; release notes only" >&2
  fi
fi

echo "desktop-publish-release-local: ${TITLE} → https://github.com/Johann-Goncalves-Pereira/Qui/releases/tag/${TAG}"

VERIFY_URL="https://github.com/Johann-Goncalves-Pereira/Qui/releases/download/${TAG}/Qui-${VER}-arm64.dmg"
echo "desktop-publish-release-local: verifying ${VERIFY_URL}..."
HTTP_STATUS="$(curl -ILs -o /dev/null -w "%{http_code}" "$VERIFY_URL" || echo "000")"
if [ "$HTTP_STATUS" != "200" ]; then
  echo "desktop-publish-release-local: warning: asset download verification returned HTTP ${HTTP_STATUS}" >&2
else
  echo "desktop-publish-release-local: verified ${VERIFY_URL} (HTTP 200 OK)"
fi
