#!/usr/bin/env bash
# Local desktop version bump after a squash-merge (BR-desktop-28).
# $0 Actions: opens a bump PR, squash-merges it, tags v<ver> on develop tip.
# Skip when QUI_SKIP_DESKTOP_VERSION_BUMP=1 or when HEAD commit is already a bump.

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "desktop-version-bump-local: not inside a git repository" >&2
  exit 1
}
cd "$ROOT"

if [ "${QUI_SKIP_DESKTOP_VERSION_BUMP:-}" = "1" ]; then
  echo "desktop-version-bump-local: skipped (QUI_SKIP_DESKTOP_VERSION_BUMP=1)"
  exit 0
fi

DIRTY="$(git diff --name-only; git diff --cached --name-only)"
if [ -n "$DIRTY" ] && [ "$DIRTY" != "scripts/desktop-version-bump-local" ]; then
  echo "desktop-version-bump-local: working tree dirty; commit or stash first" >&2
  exit 1
fi

BASE_BRANCH="${1:-}"
if [ -z "$BASE_BRANCH" ]; then
  BASE_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
fi
case "$BASE_BRANCH" in
  develop|main) ;;
  *)
    echo "desktop-version-bump-local: must run on develop/main (got ${BASE_BRANCH})" >&2
    exit 1
    ;;
esac

SELF_TMP="$(mktemp -t bump-script.XXXXXX)"
cp "$0" "$SELF_TMP"

git fetch origin "$BASE_BRANCH"
if ! git checkout "$BASE_BRANCH" 2>/dev/null; then
  echo "desktop-version-bump-local: $BASE_BRANCH is active in another worktree; working from origin/$BASE_BRANCH"
  git checkout -f --detach "origin/$BASE_BRANCH"
else
  git pull origin "$BASE_BRANCH"
fi

cp "$SELF_TMP" "$0"
rm -f "$SELF_TMP"

# Invariant: finish-pr on this fork must always synchronize develop with upstream autobrr/qui develop (BR-desktop-42).
if [ -x "$ROOT/scripts/upstream-sync-fork" ]; then
  "$ROOT/scripts/upstream-sync-fork" "$BASE_BRANCH" || {
    echo "desktop-version-bump-local: upstream sync failed; aborting bump" >&2
    exit 1
  }
  git fetch origin "$BASE_BRANCH"
  if git checkout "$BASE_BRANCH" 2>/dev/null; then
    git pull origin "$BASE_BRANCH"
  fi
fi

# Avoid bumping a bump (local commit or squash PR title on tip).
if git log -1 --pretty=%s "origin/$BASE_BRANCH" | grep -qiE 'bump( desktop)? version|Bump Desktop Version'; then
  echo "desktop-version-bump-local: tip is already a version bump; nothing to do"
  exit 0
fi


OLD_VER="$(node -p "require('./desktop/package.json').version")"
node desktop/scripts/bump-version.mjs
NEW_VER="$(node -p "require('./desktop/package.json').version")"

# Keep Homebrew cask version in lockstep with desktop package.json.
if [ -f Casks/qui.rb ]; then
  perl -pi -e "s/version \"\\d+\\.\\d+\\.\\d+\"/version \"${NEW_VER}\"/" Casks/qui.rb
fi

BRANCH="chore/desktop-bump-${NEW_VER}"
git checkout -b "$BRANCH"
git add desktop/package.json
if [ -f web/package.json ]; then
  git add web/package.json
fi
if [ -f Casks/qui.rb ]; then
  git add Casks/qui.rb
fi
if [ -f scripts/desktop-version-bump-local ]; then
  git add scripts/desktop-version-bump-local
fi
git commit -m "chore(desktop): bump version to ${NEW_VER} [skip ci]"

git push -u origin HEAD

PR_URL="$(gh pr create --base "$BASE_BRANCH" --head "$BRANCH" \
  --title "Chore 🔧: Bump Desktop Version to ${NEW_VER}" \
  --body "$(cat <<EOF
## Summary
- Patch bump \`desktop/package.json\` (and \`Casks/qui.rb\`) \`${OLD_VER}\` → \`${NEW_VER}\` (local gate; Actions usage blocked at \$0).
- Follow-up to a squash-merged PR per \`docs/desktop/versioning.md\` / BR-desktop-28.

## Test plan
- [x] \`node desktop/scripts/bump-version.mjs\` applied
- [ ] Tag \`v${NEW_VER}\` exists on \`${BASE_BRANCH}\` after merge
- [ ] GitHub Release \`Qui v${NEW_VER}\` is Latest (after publish step)

## ⚠️ Upstream Docker Alignment & Breaking Change Risk
- **Target Architectural Layer:** Desktop Shell \`desktop/\`
- **Upstream Layout Coupling:** None
- **Potential Breakage Vectors:** None
- **Defensive Guardrails & Isolation:** Version metadata only
- **Future Upstream Sync Impact:** None
EOF
)")"

echo "desktop-version-bump-local: opened ${PR_URL}"

PR_NUM="$(gh pr view --json number -q .number)"
gh pr merge "$PR_NUM" --squash --delete-branch

git fetch origin "$BASE_BRANCH"
if ! git checkout "$BASE_BRANCH" 2>/dev/null; then
  git checkout --detach "origin/$BASE_BRANCH"
else
  git pull origin "$BASE_BRANCH"
fi
git branch -D "$BRANCH" 2>/dev/null || true

# Tag the develop tip that contains the bump (after squash).
# Force non-interactive lightweight tag (repo may default to annotated + $EDITOR).
if git rev-parse "v${NEW_VER}" >/dev/null 2>&1; then
  echo "desktop-version-bump-local: tag v${NEW_VER} already exists locally"
else
  GIT_EDITOR=true git tag -a "v${NEW_VER}" "origin/${BASE_BRANCH}" -m "desktop ${NEW_VER}"
fi
git push origin "v${NEW_VER}"

# Create/refresh GitHub Release as Latest (assets if desktop/release/ has them).
if [ -x "$ROOT/scripts/desktop-publish-release-local" ]; then
  "$ROOT/scripts/desktop-publish-release-local" || {
    echo "desktop-version-bump-local: warning: publish release failed (tag is still pushed)" >&2
  }
fi

echo "desktop-version-bump-local: ${OLD_VER} → ${NEW_VER} (tag v${NEW_VER} on ${BASE_BRANCH})"
