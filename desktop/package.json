{
  "name": "qui-desktop",
  "productName": "Qui",
  "version": "0.0.15",
  "description": "Qui Desktop - Native qBittorrent WebUI with Electron",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && mkdir -p dist/assets/branding && cp src/assets/branding/logo.png src/assets/branding/menu-bar.svg src/assets/branding/menu-bar.png dist/assets/branding/",
    "lint": "biome check src tests && eslint src tests",
    "format": "biome check --write src tests",
    "test": "vitest run",
    "version:bump": "node scripts/bump-version.mjs",
    "start": "pnpm build && electron dist/main/index.js",
    "dev": "tsc -w",
    "dev:app": "pnpm build && concurrently -k \"tsc -w --preserveWatchOutput\" \"QUI_DESKTOP_DEV=1 electronmon dist/main/index.js\"",
    "refresh": "../scripts/desktop-refresh",
    "package:mac": "pnpm build && electron-builder --mac --dir -c.mac.identity=\"-\"",
    "package:mac:release": "pnpm build && electron-builder --mac dmg zip -c.mac.identity=\"-\"",
    "install:local": "pnpm package:mac && rm -rf /Applications/Qui.app && cp -R release/mac-arm64/Qui.app /Applications/ && echo 'Qui.app successfully installed to /Applications/Qui.app'"
  },
  "build": {
    "appId": "com.autobrr.qui.desktop",
    "productName": "Qui",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!dist/builder*/**"
    ],
    "extraResources": [
      {
        "from": "release/qui-desktop-image-${arch}.tar.gz",
        "to": "assets/qui-desktop-image-${arch}.tar.gz",
        "filter": [
          "*.tar.gz"
        ]
      }
    ],
    "protocols": [
      {
        "name": "Magnet URI Scheme",
        "schemes": [
          "magnet"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dir",
        "dmg",
        "zip"
      ],
      "identity": "-"
    }
  },
  "dependencies": {
    "effect": "^3.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@eslint/js": "^9.20.0",
    "@types/node": "^24.19.2",
    "concurrently": "^9.2.1",
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0",
    "electronmon": "^2.0.3",
    "eslint": "^9.20.0",
    "globals": "^16.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.0.7"
  }
}
