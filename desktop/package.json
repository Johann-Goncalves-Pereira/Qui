{
  "name": "qui-desktop",
  "productName": "Qui",
  "version": "1.0.0",
  "description": "Qui Desktop - Native qBittorrent WebUI with Electron",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "lint": "biome check src tests && eslint src tests",
    "format": "biome check --write src tests",
    "test": "vitest run",
    "start": "tsc && electron dist/main/index.js",
    "dev": "tsc -w"
  },
  "dependencies": {
    "effect": "^3.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@eslint/js": "^9.20.0",
    "@types/node": "^24.19.2",
    "electron": "^35.0.0",
    "eslint": "^9.20.0",
    "globals": "^16.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.0.7"
  }
}
