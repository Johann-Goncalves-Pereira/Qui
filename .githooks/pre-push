#!/usr/bin/env bash
# Local repository rules (replaces GitHub Actions upstream-sync + develop push block).
# - Block direct pushes to develop/main
# - Require a clean dry-merge with autobrr/qui develop before other pushes

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
CHECK="$ROOT/scripts/upstream-sync-check"

remote_name="${1:-}"
# remote URL is $2; unused

blocked=0
need_sync=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Deletion
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  branch="${remote_ref#refs/heads/}"
  case "$branch" in
    develop|main)
      echo "pre-push: direct push to '${branch}' is blocked." >&2
      echo "Open a pull request and squash-merge after ./scripts/upstream-sync-check passes." >&2
      blocked=1
      ;;
    *)
      need_sync=1
      ;;
  esac
done

if [ "$blocked" -eq 1 ]; then
  exit 1
fi

if [ "$need_sync" -eq 1 ]; then
  if [ ! -x "$CHECK" ]; then
    echo "pre-push: missing executable $CHECK" >&2
    exit 1
  fi
  echo "pre-push: running upstream-sync-check (remote=${remote_name})…"
  "$CHECK"
fi

exit 0
